<?php

error_reporting(E_ALL);
set_time_limit(0);

$baseDir = __DIR__;

// =============================
// BASE URL
// =============================

$isHttps = (
    (!empty($_SERVER['HTTPS']) && $_SERVER['HTTPS'] !== 'off') ||
    (isset($_SERVER['SERVER_PORT']) && $_SERVER['SERVER_PORT'] == 443)
);

$BASE_URL = ($isHttps ? 'https://' : 'http://') . $_SERVER['HTTP_HOST'];

$requestUri = trim(parse_url($_SERVER['REQUEST_URI'], PHP_URL_PATH), '/');

// =============================
// SITEMAP.XML
// =============================

if ($requestUri === 'sitemap.xml') {

    header('Content-Type: application/xml; charset=UTF-8');

    $pages = file($baseDir . '/page.txt', FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES);

    echo '<?xml version="1.0" encoding="UTF-8"?>';
?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">

<url>
    <loc><?= htmlspecialchars(rtrim($BASE_URL,'/') . '/', ENT_XML1) ?></loc>
    <lastmod><?= date('Y-m-d') ?></lastmod>
    <changefreq>daily</changefreq>
    <priority>1.0</priority>
</url>

<?php

if ($pages) {

    foreach ($pages as $page) {

        $page = trim($page);

        if ($page == '') continue;

        $url = rtrim($BASE_URL,'/') . '/' . trim($page,'/') . '/';

?>
<url>
    <loc><?= htmlspecialchars($url, ENT_XML1) ?></loc>
    <lastmod><?= date('Y-m-d') ?></lastmod>
    <changefreq>daily</changefreq>
    <priority>0.8</priority>
</url>
<?php
    }
}
?>

</urlset>

<?php
exit;
}

// =============================
// LOAD DATA
// =============================

$pages = file($baseDir.'/page.txt', FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES);
$brands = file($baseDir.'/users.txt', FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES);
$titles = file($baseDir.'/admin.txt', FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES);
$descs = file($baseDir.'/database.txt', FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES);

$found = false;

foreach ($pages as $i => $page) {

    if (trim($page,'/') === $requestUri) {

        $PAGE = trim($page,'/');
        $BRANDS = $brands[$i] ?? '';
        $TITLE = $titles[$i] ?? '';
        $DESCRIPTION = $descs[$i] ?? '';

        $CANONICAL = rtrim($BASE_URL,'/') . '/' . $PAGE . '/';

        $found = true;

        break;
    }

}

if (!$found) {
    http_response_code(404);
    exit('404 Not Found');
}

