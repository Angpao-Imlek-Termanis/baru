<style>

.naga-gif{
  position:fixed;
  inset:0;
  z-index:9999;
  pointer-events:none;
  overflow:hidden;
}


.naga{
  position:absolute;
  top:50%;
  width:100vw;
  height:100vh;
  background-repeat:no-repeat;
  background-size:contain;
  opacity:1;
  filter:drop-shadow(0 0 35px rgba(255,255,255,.9))
         brightness(1.2)
         contrast(1.2);
  transform:translateY(-50%);
  transition:all 2.8s ease-in-out;
}


.naga-kiri{
  left:-100%;
  background-image:url("https://dragon-bonar.b-cdn.net/naga-bonar.webp");
  background-position:left center;
}


.naga-kanan{
  right:-100%;
  background-image:url("https://dragon-bonar.b-cdn.net/naga-bonar.webp");
  background-position:right center;
  transform:translateY(-50%) rotateY(180deg);
}


.naga-kiri.active{ left:-10%; }
.naga-kanan.active{ right:-10%; }


@media(max-width:768px){
  .naga{ opacity:.9; }
}
</style>

